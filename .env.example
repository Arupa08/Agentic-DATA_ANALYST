# Copy to .env and fill in. Never commit .env.

# LLM tiers as "provider:model". Pick final models by eval results, not by default.
# Free option: Gemini API free tier. Get a key at https://aistudio.google.com/apikey
# (free-tier prompts may be used by Google to improve its products; this project's data is synthetic)
CHEAP_MODEL=google_genai:gemini-3.5-flash-lite
STRONG_MODEL=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=replace-me

# Paid alternative: OpenAI
# CHEAP_MODEL=openai:gpt-4o-mini
# STRONG_MODEL=openai:gpt-4o
# OPENAI_API_KEY=sk-replace-me

# Throttle every model call to stay under free-tier per-minute limits (check yours in AI Studio)
LLM_REQUESTS_PER_MINUTE=10
LLM_MAX_RETRIES=3

# LangSmith tracing (optional; leave false without a LangSmith key)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nl-analytics-agent

# Database (agent opens it read-only)
DATABASE_URL=sqlite:///data/shop.db

# Business glossary in the planner prompt (set false to measure its effect)
USE_GLOSSARY=true

# Optional web search for external context (disabled when empty)
TAVILY_API_KEY=

# Logging
LOG_LEVEL=INFO
